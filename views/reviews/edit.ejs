<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <h3>Edit Your Review</h3>

  <form action="/listings/<%= listingId %>/reviews/<%= review._id %>?_method=PUT"
        method="POST">

    <div class="star-rating">
      <% for (let i = 5; i >= 1; i--) { %>
        <input
          type="radio"
          id="star-<%= i %>-<%= review._id %>"
          name="review[rating]"
          value="<%= i %>"
          <%= review.rating === i ? "checked" : "" %>>
        <label for="star-<%= i %>-<%= review._id %>">★</label>
      <% } %>
    </div>

    <textarea name="review[comment]" required><%= review.comment %></textarea>

    <br>

    <button class="btn btn-primary btn-sm">Update Review</button>
    <a href="/listings/<%= listingId %>" class="btn btn-secondary btn-sm">
      Cancel
    </a>
  </form>
</div>
