<% layout("/layouts/boilerplate") %>

<div class="edit-listing-container">
    <h1 class="form-title">Edit Listing</h1>

    <form 
      action="/listings/<%= listing._id %>?_method=PUT" 
      method="POST" 
      class="listing-form"
      enctype="multipart/form-data">

        <div class="form-group">
            <label>Title</label>
            <input 
              type="text" 
              name="listing[title]" 
              value="<%= listing.title %>" 
              required>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea 
              name="listing[description]" 
              rows="3"><%= listing.description %></textarea>
        </div>

        <div class="form-group">
            <label>Upload New Image</label>
            <input 
              type="file" 
              name="image" 
              value="<%= listing.image.url %>"
              >
        </div>

        <div class="form-group">
            <label>Price</label>
            <input 
              type="number" 
              name="listing[price]" 
              value="<%= listing.price %>">
        </div>

        <div class="form-group">
            <label>Location</label>
            <input 
              type="text" 
              name="listing[location]" 
              value="<%= listing.location %>">
        </div>

        <div class="form-group">
            <label>Country</label>
            <input 
              type="text" 
              name="listing[country]" 
              value="<%= listing.country %>">
        </div>

        <button type="submit" class="submit-btn">
            Update Listing
        </button>
    </form>

    <a href="/listings/<%= listing._id %>" class="back-link">
        ⬅ Back to listing
    </a>
</div>
